# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your actual local configuration.
# Do NOT commit actual credentials or secrets to version control.
# =============================================================================

# Database Connection Configuration
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# JWT Secret Key for Admin Auth (Must be a long, secure random string)
JWT_SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>

# Initial Admin Seed Credentials (Optional - used by app/init_admin.py)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<SET_INITIAL_ADMIN_PASSWORD>